# Copy to repository root as .env.step08.ps1, fill the blank key locally,
# then explicitly dot-source it. The application never auto-loads this file.
$env:PSYEVO_LIVE_PROBE_ENABLED = 'true'
$env:PSYEVO_PROVIDER_BASE_URL = 'https://ai.hybgzs.com/v1'
$env:PSYEVO_PROVIDER_MODEL = 'grok-4.7'
$env:PSYEVO_PROVIDER_API_KEY = ''
$env:PSYEVO_PROVIDER_DEADLINE_SECONDS = '60'
$env:PSYEVO_PROVIDER_MAX_OUTPUT_TOKENS = '1024'
